; CHK Pirate Warrior — Godot 4.6.3 stable
; V8 Stabilité Android : jouabilité filtrée, caméra physique, héros au gouvernail et culling adaptatif.
; L’océan, les bateaux, bâtiments, animaux et collisions restent en 3D.
; Les héros et personnages importants utilisent une intégration 2.5D dans le monde.
; L’autoload AdaptiveAudio utilise la classe AdaptiveAudioDirectorV7.

config_version=5

[application]

config/name="CHK Pirate Warrior V8 Stabilité"
run/main_scene="res://scenes/main.tscn"
run/max_fps=60
config/icon="res://assets/ui/icon_512.png"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/bg_color=Color(0.012, 0.026, 0.052, 1)
boot_splash/show_image=false

[autoload]

ThirdPersonCameraGuard="*res://scripts/third_person_camera_guard.gd"
HeroMaterialRenderer="*res://scripts/hero_material_renderer.gd"
GameplayRepair="*res://scripts/gameplay_repair_v4.gd"
StudioGameDirector="*res://scripts/studio_game_director_v8.gd"
BoatPresentationDirector="*res://scripts/boat_presentation_director.gd"
StudioGameplayUpgrade="*res://scripts/studio_gameplay_upgrade.gd"
ArchipelagoMinimap="*res://scripts/archipelago_minimap_v4.gd"
TargetHealthHud="*res://scripts/target_health_hud.gd"
AAAPresentationDirector="*res://scripts/aaa_presentation_director.gd"
Roster25DDirector="*res://scripts/roster_25d_director_v4.gd"
CombatVarietyDirector="*res://scripts/combat_variety_director.gd"
AdaptiveAudio="*res://scripts/adaptive_audio_director_v7.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=864
window/size/window_width_override=1280
window/size/window_height_override=576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/handheld/vibrate_on_press=true
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.02, 0.08, 0.15, 1)
limits/opengl/max_lights_per_object=4
limits/opengl/max_renderable_lights=8

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[audio]

general/text_to_speech=true
driver/enable_input=false
default_bus_layout="res://default_bus_layout.tres"

[input]

move_forward={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventMouseButton,"button_index":1)]}
skill={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
aura={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325),Object(InputEventKey,"physical_keycode":70)]}
switch_hero={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":9)]}
pause_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
